{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semper public process evidence v1",
  "description": "Shape validation only. Run benchmark.py validate for metric recomputation, timing, fixed limitations and repeat integrity. Neither status permits performance ranking.",
  "oneOf": [
    {
      "$ref": "#/$defs/unmeasured"
    },
    {
      "$ref": "#/$defs/observational"
    }
  ],
  "$defs": {
    "statistics": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "median": {
          "type": "number",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "sample_stdev": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "count",
        "min",
        "median",
        "mean",
        "p95",
        "max",
        "sample_stdev"
      ],
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "properties": {
        "elapsed_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cpu_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "rss_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "footprint_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "elapsed_ns",
        "cpu_ns",
        "rss_bytes",
        "footprint_bytes"
      ],
      "additionalProperties": false
    },
    "trial_summary": {
      "type": "object",
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "cpu_percent": {
          "type": "number",
          "minimum": 0
        },
        "interval_cpu_percent": {
          "$ref": "#/$defs/statistics"
        },
        "rss_mib": {
          "$ref": "#/$defs/statistics"
        },
        "footprint_mib": {
          "$ref": "#/$defs/statistics"
        }
      },
      "required": [
        "duration_seconds",
        "cpu_seconds",
        "cpu_percent",
        "interval_cpu_percent",
        "rss_mib",
        "footprint_mib"
      ],
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "summary": {
          "$ref": "#/$defs/trial_summary"
        }
      },
      "required": [
        "repeat",
        "samples",
        "summary"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "job": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "build_label": {
          "type": "string",
          "minLength": 1
        },
        "warmup_seconds": {
          "type": "number",
          "minimum": 0
        },
        "interval_seconds": {
          "type": "number",
          "minimum": 0.01
        },
        "intervals_per_repeat": {
          "type": "integer",
          "minimum": 1
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "confounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "job",
        "workload",
        "configuration",
        "build_label",
        "warmup_seconds",
        "interval_seconds",
        "intervals_per_repeat",
        "repeats",
        "confounds"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "image_uuid": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plist_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_architecture": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bundle_id",
        "version",
        "build",
        "image_uuid",
        "executable_sha256",
        "plist_sha256",
        "image_architecture"
      ],
      "additionalProperties": false
    },
    "machine": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "chip": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "os_build": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "power_source": {
          "title": "Power source at matching endpoint snapshots",
          "description": "Observed before the first warmup and after all trials. Matching values do not rule out intervening power-source transitions.",
          "type": "string",
          "minLength": 1
        },
        "logical_cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "timebase_hz": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "model",
        "chip",
        "os_version",
        "os_build",
        "architecture",
        "python_version",
        "power_source",
        "logical_cpus",
        "memory_bytes",
        "timebase_hz"
      ],
      "additionalProperties": false
    },
    "unmeasured": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "comparison_eligible": {
          "const": false,
          "type": "boolean"
        },
        "status": {
          "const": "unmeasured"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "product",
        "recorded_at",
        "comparison_eligible",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "observational": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "comparison_eligible": {
          "const": false,
          "type": "boolean"
        },
        "status": {
          "const": "observational"
        },
        "collector_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build": {
          "$ref": "#/$defs/build"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "limitations": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trial"
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "trial_cpu_percent": {
              "$ref": "#/$defs/statistics"
            },
            "trial_median_rss_mib": {
              "$ref": "#/$defs/statistics"
            },
            "trial_median_footprint_mib": {
              "$ref": "#/$defs/statistics"
            }
          },
          "required": [
            "trial_cpu_percent",
            "trial_median_rss_mib",
            "trial_median_footprint_mib"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "product",
        "recorded_at",
        "comparison_eligible",
        "status",
        "collector_sha256",
        "build",
        "machine",
        "protocol",
        "limitations",
        "trials",
        "summary"
      ],
      "additionalProperties": false
    }
  }
}
